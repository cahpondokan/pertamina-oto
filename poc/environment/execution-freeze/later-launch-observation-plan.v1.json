  ],
  "requiredHumanAndSecurityFields": {
    "executionApprover": "REQUIRED_NOT_SET",
    "securityReviewer": "REQUIRED_NOT_SET",
    "environmentOwner": "REQUIRED_NOT_SET",
    "evidenceOwner": "REQUIRED_NOT_SET",
    "authorizedManifestTemplateChecklistAndFixtureDigests": "REQUIRED_NOT_SET",
    "approvedLeastPrivilegeIdentityClass": "REQUIRED_NOT_SET",
    "approvedHostNetworkCollectorPrivilegeAndNonPublicCanary": "REQUIRED_NOT_SET",
