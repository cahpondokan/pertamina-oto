    { "id": "PRE-004", "status": "OUT_OF_SCOPE_FOR_BENIGN_ENVIRONMENT_OBSERVATION", "required": "candidate remains absent" },
    { "id": "PRE-005", "status": "OUT_OF_SCOPE_FOR_BENIGN_ENVIRONMENT_OBSERVATION", "required": "no candidate or redistribution decision is inferred" },
    { "id": "PRE-006", "status": "BLOCKED_INDEPENDENT_SECURITY_REVIEW", "required": "identity, containment, collector, network canary, privilege, and stop-rule approval" },
    { "id": "PRE-007", "status": "BLOCKED_APPROVED_BENIGN_FIXTURE_MANIFEST", "required": "inert synthetic-only mapped input with owner, hash, access, retention, and disposal" },
    { "id": "PRE-008", "status": "BLOCKED_INDEPENDENT_ENVIRONMENT_ORACLE", "required": "expected control observations and reviewer identity" },
    { "id": "PRE-009", "status": "HOST_OBSERVED_GUEST_AND_EFFECTIVE_CONTROLS_UNPROVEN", "required": "fresh host binding plus authorized guest observation" },
    { "id": "PRE-010", "status": "PLAN_PREPARED_NUMERIC_SAMPLING_AND_CEILINGS_UNAPPROVED", "required": "collector versions, sampling, duration, CPU/RAM/temp/output/handle/thread limits, cancel and close deadline" },
    { "id": "PRE-011", "status": "ROOT_APPROVED_POLICY_FIELDS_INCOMPLETE", "required": "run access, retention, expiry, disposal, classification mapping, evidence owner, reviewer, and immutable index" },
