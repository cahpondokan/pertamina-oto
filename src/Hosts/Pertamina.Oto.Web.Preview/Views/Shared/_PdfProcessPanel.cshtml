@model PdfFlowViewModel
<section id="@(Model.Prefix)-progress" class="merge-flow" hidden aria-label="Proses lokal"><div class="merge-flow-scroll"><div class="merge-panel-title"><span class="merge-orbit" aria-hidden="true"></span><div><small>PROSES LOKAL</small><h2 id="@(Model.Prefix)-progress-title">Memeriksa PDF</h2></div></div><ol class="merge-process-steps"><li data-stage="inspect">Periksa</li><li data-stage="copy">@Model.Action</li><li data-stage="verify">Hasil</li></ol><div class="merge-progress-heading"><strong id="@(Model.Prefix)-percent">—</strong><span id="@(Model.Prefix)-progress-count"></span></div><progress class="workspace-meter" id="@(Model.Prefix)-meter"></progress><p id="@(Model.Prefix)-progress-detail">Menyiapkan proses lokal…</p><small>Progres menunjukkan tahap yang sedang dikerjakan.</small></div><button id="@(Model.Prefix)-cancel" class="button">Batalkan proses</button><small class="merge-trust">✓ File asli tetap utuh</small></section>
